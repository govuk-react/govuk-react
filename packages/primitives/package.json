{
  "name": "@govuk-react/primitives",
  "version": "0.2.0",
  "description": "Headless, progressively enhanced behaviour for design system components: custom elements with React parts over them.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./inline/*": "./dist/inline/*",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "licences"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup --config tsup.inline.config.ts && tsup"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "author": "Alasdair McLeay",
  "license": "MIT",
  "homepage": "https://github.com/govuk-react/govuk-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/govuk-react/govuk-react.git",
    "directory": "packages/primitives"
  },
  "publishConfig": {
    "access": "public"
  }
}
