---
import * as Tabs from '@govuk-react/primitives/tabs';
import '@govuk-react/primitives/styles.css';
---

<html lang="en">
  <head><meta charset="utf-8" /><title>Tabs</title><link rel="icon" href="data:," /></head>
  <body>
    <!-- Parts rendered without a Root, each panel its own island, so no React context links them. -->
    <govuk-react-tabs data-testid="islands" default-value="i-documents">
      <div data-tabs-list>
        <Tabs.Trigger value="i-account">Account</Tabs.Trigger>
        <Tabs.Trigger value="i-documents">Documents</Tabs.Trigger>
      </div>
      <Tabs.Content client:load value="i-account" name="i">Account panel</Tabs.Content>
      <Tabs.Content client:load value="i-documents" name="i" defaultSelected>Documents panel</Tabs.Content>
    </govuk-react-tabs>
    <script>
      import '@govuk-react/primitives/tabs-element';
    </script>
  </body>
</html>
