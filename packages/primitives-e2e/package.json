{
  "name": "@govuk-react/primitives-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser tests for @govuk-react/primitives: without JavaScript, upgraded, hydrated, in islands and client-only",
  "scripts": {
    "build:site": "pnpm --filter @govuk-react/primitives build && astro build",
    "preview": "astro preview",
    "test:e2e": "playwright test",
    "test:e2e:hydration": "playwright test --config playwright.hydration.config.ts"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@govuk-react/primitives": "workspace:*",
    "astro": "^7.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
