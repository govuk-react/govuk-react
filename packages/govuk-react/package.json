{
  "name": "govuk-react",
  "version": "1.0.0-alpha.1",
  "description": "govuk-react: React components for the GOV.UK Design System, built on govuk-frontend-react.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && pnpm copy-readme",
    "copy-readme": "cp ../../README.md ../../LICENSE ."
  },
  "dependencies": {
    "@govuk-react/icon-crown": "0.1.0",
    "@govuk-react/primitives": "0.2.1",
    "clsx": "^2.1.1",
    "govuk-frontend-react": "1.0.0-alpha.6"
  },
  "peerDependencies": {
    "govuk-frontend": "~6.6.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "author": "Alasdair McLeay",
  "license": "MIT",
  "homepage": "https://github.com/govuk-react/govuk-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/govuk-react/govuk-react.git",
    "directory": "packages/govuk-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "govuk-frontend": "6.6.0"
  }
}
