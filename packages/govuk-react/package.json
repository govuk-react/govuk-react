{
  "name": "govuk-react",
  "version": "0.10.7",
  "description": "govuk-react: A port of the govuk-frontend components for React using styled-components.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=4096 tsup && pnpm copy-readme",
    "copy-readme": "cp ../../README.md ../../LICENSE ."
  },
  "dependencies": {
    "@govuk-react/icon-crown": "0.1.0",
    "clsx": "^2.1.1",
    "govuk-colours": "^1.1.0",
    "govuk-frontend-react": "1.0.0-alpha.4",
    "multi-input-input": "0.0.3",
    "polished": "^4.3.1",
    "react-markdown": "^5.0.3"
  },
  "peerDependencies": {
    "govuk-frontend": "~6.6.0",
    "react": ">=19",
    "react-dom": ">=19",
    "styled-components": ">=5.1"
  },
  "author": "Alasdair McLeay",
  "license": "MIT",
  "homepage": "https://github.com/govuk-react/govuk-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/govuk-react/govuk-react.git",
    "directory": "packages/govuk-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "govuk-frontend": "6.6.0"
  }
}
