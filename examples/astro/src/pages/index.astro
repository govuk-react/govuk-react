---
import { Body } from 'govuk-react/body';
import { GridColumn } from 'govuk-react/grid-column';
import { GridRow } from 'govuk-react/grid-row';
import { Heading } from 'govuk-react/heading';
import { Link } from 'govuk-react/link';
import { List } from 'govuk-react/list';
import { forms, hydration } from '../components/Chrome';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Examples">
  <GridRow>
    <GridColumn width="two-thirds">
      <Heading size="l" headingLevel={1}>govuk-react with Astro</Heading>
      <Body>These pages are rendered on the server by Astro, and work before and without JavaScript.</Body>
      <Heading size="m" headingLevel={2}>Forms</Heading>
      <Body>
        These forms use <Link href="https://conform.guide/">Conform</Link>. They submit, and show their errors, before
        and without JavaScript.
      </Body>
      <List variant="bullet">
        {
          forms.map((example) => (
            <li>
              <Link href={example.href}>{example.text}</Link>: {example.description}
            </li>
          ))
        }
      </List>
      <Heading size="m" headingLevel={2}>Hydration</Heading>
      <Body>These pages choose how much JavaScript each component needs.</Body>
      <List variant="bullet">
        {
          hydration.map((example) => (
            <li>
              <Link href={example.href}>{example.text}</Link>: {example.description}
            </li>
          ))
        }
      </List>
    </GridColumn>
  </GridRow>
</Layout>
