---
import {
  InlineScript,
  accordion,
  characterCount,
  choices,
  fileUpload,
  modal,
  tabs,
} from '@govuk-react/primitives/inline-script';
import { Body } from 'govuk-react/body';
import { GridColumn } from 'govuk-react/grid-column';
import { GridRow } from 'govuk-react/grid-row';
import { Heading } from 'govuk-react/heading';
import { Application } from '../features/together';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Working together">
  <Fragment slot="head">
    <InlineScript script={accordion} />
    <InlineScript script={characterCount} />
    <InlineScript script={choices} />
    <InlineScript script={fileUpload} />
    <InlineScript script={modal} />
    <InlineScript script={tabs} />
  </Fragment>
  <GridRow>
    <GridColumn width="two-thirds">
      <Heading size="l" headingLevel={1}>Your licence application</Heading>
      <Body>
        Tabs, an accordion and modals holding forms, all in one island with <code>client:idle</code>. Each component’s
        script is inlined in the page’s head, so they all work before React loads, and keep what you’ve done once it
        has.
      </Body>
      <Application client:idle />
    </GridColumn>
  </GridRow>
</Layout>
