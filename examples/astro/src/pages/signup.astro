---
import { actions } from 'astro:actions';
import { SignupForm } from '../features/signup';
import { formState } from '../form-state';
import Layout from '../layouts/Layout.astro';

const { action, redirectTo, lastResult, hasErrors } = formState(Astro, actions.signup);

if (redirectTo) {
  return Astro.redirect(redirectTo);
}
---

<Layout title="Create an account" error={hasErrors}>
  <SignupForm client:load action={action} lastResult={lastResult} />
</Layout>
