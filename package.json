{
  "name": "@govuk-react/monorepo",
  "scripts": {
    "build:dist": "pnpm build && rimraf dist && webpack --mode production --devtool source-map --entry ./packages/govuk-react/dist/index.js --output-library-type commonjs2",
    "build:storybook": "pnpm --filter @govuk-react/storybook build",
    "build:types": "tsc --emitDeclarationOnly --declaration",
    "build": "pnpm -r --filter './packages/**' run build",
    "bundlesize": "bundlesize",
    "clean:workspace": "rimraf packages/*/dist",
    "clean": "rimraf lib && rimraf es",
    "coverage": "vitest run --coverage",
    "eslint:fix": "eslint --fix .",
    "eslint": "eslint .",
    "start": "pnpm --filter @govuk-react/storybook start",
    "test:e2e": "pnpm --filter @govuk-react/example-application test:e2e && pnpm --filter @govuk-react/primitives-e2e test:e2e && pnpm --filter @govuk-react/primitives-e2e test:e2e:hydration && pnpm --filter \"govuk-react...\" build && pnpm --filter @govuk-react/example-astro test:e2e && pnpm --filter @govuk-react/benchmark test:e2e",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:snapshot": "vitest run -u",
    "test:unit": "vitest run",
    "test:types": "tsc --noEmit --declaration -p ./tsconfig.json",
    "test": "cross-env CI=true pnpm test:unit && pnpm eslint && pnpm format:check && pnpm test:types",
    "format": "prettier --write \"**/*.{js,mjs,cjs,jsx,ts,mts,tsx}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,jsx,ts,mts,tsx}\"",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "description": "React components for the GOV.UK Design System, built on govuk-frontend-react.",
  "main": "lib/index.js",
  "module": "es/index.js",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=12"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@babel/cli": "8.1.0",
    "@babel/core": "8.1.3",
    "@babel/node": "8.1.2",
    "@babel/plugin-transform-runtime": "8.1.2",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@changesets/cli": "^3.0.3",
    "@conform-to/react": "^1.21.3",
    "@conform-to/zod": "^1.21.3",
    "@eslint/js": "^9.39.5",
    "@storybook/react": "10.6.8",
    "@tanstack/react-form": "^1.33.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "babel-plugin-add-module-exports": "^1.0.4",
    "bundlesize2": "^0.0.35",
    "chalk": "^6.0.1",
    "codacy-coverage": "^3.4.0",
    "core-js": "^3.51.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "final-form": "^5.0.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "mkdirp-promise": "^5.0.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.3.1",
    "react-final-form": "^7.0.1",
    "react-hook-form": "^7.92.0",
    "react-is": "^19.3.1",
    "react-router": "^8.5.2",
    "rimraf": "^6.1.4",
    "storybook": "10.6.8",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "5.1.1",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/govuk-react/govuk-react.git"
  },
  "author": "Alasdair McLeay",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/govuk-react/govuk-react/issues"
  },
  "homepage": "https://github.com/govuk-react/govuk-react#readme",
  "bundlesize": [
    {
      "path": "./dist/main.js",
      "maxSize": "120 kB"
    }
  ],
  "private": true,
  "packageManager": "pnpm@12.21.0"
}
