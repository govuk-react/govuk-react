{
  "name": "@govuk-react/monorepo",
  "scripts": {
    "build:dist": "pnpm build && rimraf dist && webpack --node-env=production --devtool source-map --entry ./packages/govuk-react/dist/govuk-react.esm.js",
    "build:storybook": "pnpm --filter @govuk-react/storybook build",
    "build:types": "tsc --emitDeclarationOnly --declaration",
    "build": "preconstruct build && pnpm -r --filter=!@govuk-react/monorepo run build",
    "bundlesize": "bundlesize",
    "clean:workspace": "rimraf packages/*/lib && rimraf packages/*/es && rimraf components/*/lib && rimraf components/*/es",
    "clean": "rimraf lib && rimraf es",
    "coverage": "vitest run --coverage",
    "create-component": "node ./scripts/createComponent.js",
    "docs:components": "pnpm -r --parallel --filter=!@govuk-react/monorepo run docs",
    "docs": "pnpm docs:components && concat ./components/*/README.md -o ./API.md",
    "eslint:fix": "eslint --fix .",
    "eslint": "eslint .",
    "start": "pnpm --filter @govuk-react/storybook start",
    "test:e2e": "pnpm --filter @govuk-react/example-application test:e2e",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:snapshot": "vitest run -u",
    "test:unit": "vitest run",
    "test:types": "tsc --noEmit --declaration -p ./tsconfig.json",
    "test": "cross-env CI=true pnpm test:unit && pnpm eslint && pnpm format:check && pnpm test:types",
    "format": "prettier --write \"**/*.{js,mjs,cjs,jsx,ts,mts,tsx}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,jsx,ts,mts,tsx}\""
  },
  "description": "A port of the govuk-frontend components for React using styled-components.",
  "main": "lib/index.js",
  "module": "es/index.js",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=12"
  },
  "dependencies": {
    "govuk-colours": "^1.1.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@babel/cli": "7.23.4",
    "@babel/core": "7.23.0",
    "@babel/node": "7.22.19",
    "@babel/plugin-transform-runtime": "7.22.15",
    "@babel/preset-env": "7.22.20",
    "@babel/preset-react": "7.23.3",
    "@babel/preset-typescript": "7.23.0",
    "@eslint/js": "^9.39.5",
    "@govuk-react/api-docs": "0.10.7",
    "@preconstruct/cli": "^2.8.3",
    "@storybook/react": "10.6.7",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.19.2",
    "@types/react": "^16.14.16",
    "@types/react-router-dom": "5",
    "@types/styled-components": "^5.1.14",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "5.1.0",
    "babel-plugin-add-module-exports": "^1.0.4",
    "babel-plugin-styled-components": "^2.1.4",
    "bundlesize2": "^0.0.31",
    "can-npm-publish": "1.3.6",
    "chalk": "^4.1.1",
    "codacy-coverage": "^3.0.0",
    "concat": "^1.0.3",
    "core-js": "^3.36.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "final-form": "^4.20.10",
    "globals": "^17.14.0",
    "jest-styled-components": "^7.2.0",
    "jsdom": "^31.0.1",
    "mkdirp-promise": "^5.0.1",
    "prettier": "^3.10.1",
    "react": "^18.2.0",
    "react-docgen-typescript": "^2.1.0",
    "react-dom": "^18.2.0",
    "react-final-form": "^6.5.9",
    "react-is": "^18.2.0",
    "react-router-dom": "^6.3.0",
    "rimraf": "^5.0.5",
    "storybook": "10.6.7",
    "styled-components": "^5.3.0",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "5.1.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "workspace-alias": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/govuk-react/govuk-react.git"
  },
  "author": "Alasdair McLeay",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/govuk-react/govuk-react/issues"
  },
  "homepage": "https://github.com/govuk-react/govuk-react#readme",
  "bundlesize": [
    {
      "path": "./dist/main.js",
      "maxSize": "120 kB"
    }
  ],
  "private": true,
  "workspaces": [
    "components/*",
    "packages/*"
  ],
  "preconstruct": {
    "packages": [
      "components/*",
      "packages/*",
      "!packages/images",
      "!packages/storybook"
    ]
  },
  "packageManager": "pnpm@12.21.0",
  "resolutions": {
    "@types/react": "16.14.16"
  }
}
